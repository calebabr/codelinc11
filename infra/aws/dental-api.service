[Unit]
Description=Dental benefits API (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=dental
Group=dental
WorkingDirectory=/opt/dental/backend
EnvironmentFile=/etc/dental/dental.env
# "+" runs this one step as root so it can read the session secret and write /run/dental.
ExecStartPre=+/usr/local/bin/dental-fetch-secrets
EnvironmentFile=-/run/dental/secrets.env
ExecStart=/opt/dental/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
